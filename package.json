  "keywords": ["2048", "game", "puzzle", "pure-functions", "typescript"],
  "license": "MIT",
  "author": "Honglin Wei",
  "homepage": "https://github.com/grapefruit-leaf/arcade-core#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/grapefruit-leaf/arcade-core.git"
  },
  "bugs": {
    "url": "https://github.com/grapefruit-leaf/arcade-core/issues"
  },
